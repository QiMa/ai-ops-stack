# lanhc AI-Ops 一键栈环境变量示例。复制为 .env 后填写，不要提交真实值。

# hub 内部调度器（可选：本地/单实例可开 1，生产多副本只开一个）
AIOPS_SCHEDULER=0
AIOPS_SCHEDULER_TOKEN=change-me

# worker -> hub 认证
AIOPS_HUB_TOKEN=change-me
AIOPS_MODEL=huayu-v2
AIOPS_POLL_INTERVAL_MS=15000

# Codex 模型端点（ops-runner 镜像内置 codex CLI）
CODEX_BIN=codex
CODEX_BASE_URL=https://baizor.com/v1
CODEX_WIRE_API=responses
OPENAI_API_KEY=change-me

# headscale（只读 API key）
HEADSCALE_URL=https://headscale.lanhc.com
HEADSCALE_API_KEY=change-me

# iDRAC / Redfish（只读账号）
REDFISH_URL=https://idrac.lanhc
REDFISH_USER=readonly
REDFISH_PASSWORD=change-me

# --- worker 卡死回收 ---
# 超过该时长仍为 running 的 run 会被标记 failed
AIOPS_STALE_RUN_MS=600000
# 1 = 也回收其它 worker 遗留的 run（单机部署建议 1）
AIOPS_REAP_ANY=0
